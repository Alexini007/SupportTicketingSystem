@model TicketIndexViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<SupportTicketingSystem.Data.ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User); // Get the logged-in user
}

<h2 class="text-center mt-4">Your Recent Tickets</h2>

@if (!Model.Tickets.Any())
{
    <div class="text-center text-muted mt-4">
        <p>No tickets found.</p>
    </div>
}


<div class="container">
    <!-- this will render the tickets in the form of cards on smaller screens. this removes the problem with the horizontal scroll bar -->
    <div class="d-md-none">
        @foreach (var ticket in Model.Tickets)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@ticket.Subject</h5>
                    <p class="card-text mb-1"><strong>Description:</strong> @ticket.Description</p>
                    <p class="card-text mb-1"><strong>Team:</strong> @ticket.Team</p>
                    <p class="card-text mb-1">
                        <strong>Status:</strong>
                        <span class="badge @(ticket.Status == "new" ? "bg-info text-dark" : ticket.Status == "open" ? "bg-primary" : "bg-dark")">
                            @ticket.Status
                        </span>
                    </p>
                    <p class="card-text"><strong>Created:</strong> @ticket.CreatedAt.ToLocalTime().ToString("g")</p>

                    @if (User.Identity.IsAuthenticated && ticket.Team == Model.CurrentUserTeam)
                    {
                        <div class="text-center">
                            <div class="d-inline-flex gap-2 flex-wrap justify-content-center">
                                <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-success">Edit</a>
                                <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this ticket?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    }


                </div>
            </div>
        }
    </div>

    <!-- for larger screens, the tickets will be loaded per usual as a table format -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-bordered table-striped align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Subject</th>
                    <th>Description</th>
                    <th>Team</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model.Tickets)
                {
                    var isNewTicket = (DateTime.UtcNow - ticket.CreatedAt).TotalSeconds < 5;
                    <tr class="@(isNewTicket ? "new-ticket" : "")">
                        <td class="text-break">@ticket.Subject</td>
                        <td class="text-break">@ticket.Description</td>
                        <td>@ticket.Team</td>
                        <td>
                            <span class="badge @(ticket.Status == "new" ? "bg-info text-dark" : ticket.Status == "open" ? "bg-primary" : "bg-dark")">
                                @ticket.Status
                            </span>
                        </td>
                        <td class="text-nowrap">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            @if (User.Identity.IsAuthenticated && ticket.Team == Model.CurrentUserTeam)
                            {
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-success">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this ticket?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const rows = document.querySelectorAll(".new-ticket");

            rows.forEach(row => {
                row.style.backgroundColor = "#d2f8d2";

                setTimeout(() => {
                    row.style.transition = "background-color 1s ease-out";
                    row.style.backgroundColor = "";
                }, 5000);
            });
        });
    </script>
}