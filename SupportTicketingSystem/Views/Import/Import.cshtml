@{
    ViewData["Title"] = "Import Tickets - JSON Upload";
}

<div class="container my-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Import Tickets</h1>
        <p class="text-muted">Upload your JSON file and follow the schema to import tickets with ease.</p>
    </div>

    <div class="row gx-5">
        <div class="col-lg-6 mb-4">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h3 class="card-title fw-bold mb-3">Upload JSON File</h3>
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="fileInput" class="form-label">Select JSON File</label>
                            <input type="file" name="file" id="fileInput" class="form-control" accept=".json">
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Upload and Import</button>
                        </div>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-info mt-3" role="alert">
                                @ViewBag.Message
                            </div>
                        }
                    </form>
                </div>
            </div>
            <div class="mt-3">
                <p class="text-muted text-center">
                    Ensure your JSON file matches the format above. Required fields: <strong>Subject, Description, Team, and Status</strong>.
                </p>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h3 class="card-title fw-bold mb-3">Example JSON Schema</h3>
                    <pre class="bg-light p-3 rounded border">
[                        
    {
        "Subject": "Issue title",
        "Description": "This issue happened due to x reasons.",
        "Team": "Support",
        "Status": "new"
    }
]
                    </pre>
                    <a href="/Files/ticket-schema-example.json" class="btn btn-secondary mt-3" download="ticket-schema-example.json">
                        Download Example Schema
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
